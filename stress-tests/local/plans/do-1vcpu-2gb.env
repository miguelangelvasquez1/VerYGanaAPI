# Plan de DO: 1 vCPU / 2 GB (~USD 30); buffer pool ~60 %
# Fuente de max_connections y buffer pool: SUPUESTOS tomados de la documentación pública de
# DigitalOcean Managed MySQL (límites de conexiones por tamaño de RAM), sin crear ningún recurso.
# Anotados de memoria, sin verificar en línea: confirmarlos con SHOW VARIABLES en el cluster real.
MYSQL_CPUS=1
MYSQL_MEM=2g
MYSQL_BUFFER_POOL=1280M
MYSQL_MAX_CONNECTIONS=150
# ON solo si la rama ya trae la migración que agrega PK a las tablas que no la tienen; OFF si no.
MYSQL_REQUIRE_PK=OFF
# ON en la fase local porque V9 (CREATE TRIGGER con binlog) falla con OFF (error 1419).
# En DigitalOcean real no es configurable: está pendiente de resolver allá.
MYSQL_TRUST_FUNCTION_CREATORS=ON
# El reparto del resto del Mac (API, pool, Tomcat, k6, wiremock, minio) NO va aquí: sale de
# local/scenarios/<A|B>.env, que lt.sh carga después de este archivo (LT_SCENARIO, por defecto A).
