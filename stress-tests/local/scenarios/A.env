# Perfil del escenario A (200 VUs) en el Mac: reparto de CPU y memoria fuera de MySQL.
# lt.sh lo carga DESPUES del archivo de plan, así que estos valores mandan.
# Valores de las corridas válidas de A (L-A2), plan.md 6.4. Suma de CPU: 2 + 1 + 0,5 + 0,5 (+ MySQL) <= 9.
API_CPUS=2
API_MEM=4g
TOMCAT_THREADS_MAX=200
DB_POOL_SIZE=10
K6_CPUS=1
K6_MEM=1g
WIREMOCK_CPUS=0.5
MINIO_CPUS=0.5
