{
  "uid": "verygana-slo",
  "title": "VERyGANA · SLO",
  "description": "Objetivos de nivel de servicio por ambiente en ventana móvil de 7 días: disponibilidad (99,5 % sin 5xx) y latencia (95 % en 800 ms o menos). Las peticiones a /actuator/* no cuentan.",
  "tags": [
    "verygana",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": false,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Alertas disparadas",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "enable": true,
        "iconColor": "red",
        "step": "60s",
        "expr": "max by (alertname, severity) ({__name__=~\"ALERTS|GRAFANA_ALERTS\", alertstate=\"firing\", env=\"$env\"})",
        "titleFormat": "{{alertname}}",
        "tagKeys": "alertname,severity"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "current": {},
