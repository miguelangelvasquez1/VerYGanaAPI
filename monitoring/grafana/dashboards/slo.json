          "expr": "1 - ((sum(increase(http_server_requests_seconds_count{env=\"$env\", uri!~\"/actuator/.*\", status=~\"5..\"}[7d])) or vector(0)) / (sum(increase(http_server_requests_seconds_count{env=\"$env\", uri!~\"/actuator/.*\"}[7d])) > 0)) / 0.005",
          "legendFormat": "",
          "range": false,
          "instant": true,
