        "y": 22,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Errores que el job se traga (últimas 24h)",
      "description": "PayoutServiceImpl atrapa la excepción de cada payout dentro del bucle, así que ScheduledJobMetrics reporta el job como SUCCESS. Esta tabla es la única señal. Vacío es lo esperado.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum by (phase, exception) (round(increase(payout_processing_errors_total{env=\"$env\"}[24h]))) > 0",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
