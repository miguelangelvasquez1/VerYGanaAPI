    {
      "type": "timeseries",
      "title": "Payouts por fase",
      "description": "Las tres primeras líneas deberían converger. Un hueco entre 'creados' y 'aceptados' es plata que no salió; entre 'aceptados' y 'confirmados', webhooks que no llegaron.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "increase(payout_scheduled_total[$__rate_interval])",
          "legendFormat": "creados",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "increase(payout_sent_total{outcome=\"ACCEPTED\"}[$__rate_interval])",
          "legendFormat": "aceptados por Wompi",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "increase(payout_confirmed_total{outcome=\"PAID\"}[$__rate_interval])",
