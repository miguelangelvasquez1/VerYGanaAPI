    {
      "type": "stat",
      "title": "Balance Wompi Payouts",
      "description": "Se fondea a mano. Por debajo de $50.000 COP el ciclo de mañana falla entero. Aparece vacío (NaN) mientras no se haya logrado ninguna lectura: un cero acá sería indistinguible de una cuenta vacía.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "wompi_payout_balance_cents{env=\"$env\"} / 100",
          "legendFormat": "",
