        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "increase(payout_retried_total[$__rate_interval])",
          "legendFormat": "reintentados",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "D"
        }
