    {
      "type": "row",
      "title": "Ciclo diario",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Payouts por fase",
      "description": "Las tres primeras líneas deberían converger. Un hueco entre 'creados' y 'aceptados' es plata que no salió; entre 'aceptados' y 'confirmados', webhooks que no llegaron. Cada barra es un día UTC (19:00 a 19:00, hora de Colombia); el día en curso aparece al cerrarse.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "round(increase(payout_scheduled_total{env=\"$env\"}[1d]))",
          "legendFormat": "creados",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "round(increase(payout_sent_total{env=\"$env\", outcome=\"ACCEPTED\"}[1d]))",
          "legendFormat": "aceptados por Wompi",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "round(increase(payout_confirmed_total{env=\"$env\", outcome=\"PAID\"}[1d]))",
          "legendFormat": "confirmados PAID",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "round(increase(payout_retried_total{env=\"$env\"}[1d]))",
          "legendFormat": "reintentados",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1d",
      "maxDataPoints": 1000
    },
    {
