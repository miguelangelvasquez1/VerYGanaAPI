    {
      "type": "timeseries",
      "title": "Conexiones del pool",
      "description": "'esperando' por encima de cero son peticiones bloqueadas antes de tocar MySQL: o el pool quedó corto o hay transacciones largas.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "hikaricp_connections_active{env=\"$env\"}",
          "legendFormat": "activas",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
